FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);
boundaryField
{
    bottom  { type fixedValue; value uniform (0 0 0); }
    top     { type fixedValue; value uniform (1 0 0); }
    front   { type symmetry; }
    back    { type symmetry; }
    left    { type symmetry; }
    right   { type symmetry; }
}