# OpenMPI/Open RTE/libevent allocations retained by the MPI runtime.
# These allocations are outside CFDX ownership; the N13 MPI test must still
# report leaks originating in CFDX code.
leak:ompi_op_base_op_select
leak:ompi_op_init
leak:ompi_mpi_init
leak:orte_init
leak:orte_finalize
leak:event_base_loop
leak:mca_base_framework_components_open
leak:mca_base_framework_open
leak:mca_base_component_repository_open
leak:mca_base_component_find
leak:mca_base_framework_components_register
leak:mca_base_framework_register
